{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "vocab": {
      "@id": "https://myopencerts.netlify.app/vocab#",
      "@prefix": true
    },

    "OpenAttestationCredential": "vocab:OpenAttestationCredential",
    "EMBEDDED_RENDERER": "vocab:EMBEDDED_RENDERER",
    "uen": "vocab:uen",
    "email": "vocab:email",

    "admissionDate": {
      "@id": "vocab:admissionDate",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "graduationDate": {
      "@id": "vocab:graduationDate",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "cumulativeScore": {
      "@id": "vocab:cumulativeScore",
      "@type": "http://www.w3.org/2001/XMLSchema#double"
    },

    "recipient": {
      "@id": "vocab:recipient",
      "@context": {
        "name": "vocab:recipientName",
        "nric": "vocab:nric",
        "studentId": "vocab:studentId"
      }
    },

    "qualificationLevel": {
      "@id": "vocab:qualificationLevel",
      "@context": {
        "frameworkName": "vocab:frameworkName",
        "frameworkVersion": "vocab:frameworkVersion",
        "code": "vocab:code",
        "description": "vocab:description"
      }
    },

    "fieldOfStudy": {
      "@id": "vocab:fieldOfStudy",
      "@context": {
        "frameworkName": "vocab:frameworkName",
        "frameworkVersion": "vocab:frameworkVersion",
        "code": "vocab:code",
        "description": "vocab:description"
      }
    },

    "transcript": {
      "@id": "vocab:transcript",
      "@context": {
        "name": "vocab:courseName",
        "grade": "vocab:grade",
        "courseCredit": {
          "@id": "vocab:courseCredit",
          "@type": "http://www.w3.org/2001/XMLSchema#integer"
        },
        "courseCode": "vocab:courseCode",
        "semester": "vocab:semester",
        "gpa": "vocab:gpa"
      }
    },

    "additionalData": {
      "@id": "vocab:additionalData",
      "@context": {
        "additionalCertId": "vocab:additionalCertId",
        "merit": "vocab:merit",
        "studentId": "vocab:studentId",
        "transcriptId": "vocab:transcriptId",
        "transcriptDate": {
          "@id": "vocab:transcriptDate",
          "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
        },
        "performancerange": "vocab:performancerange",

        "certSignatories": {
          "@id": "vocab:certSignatories",
          "@context": {
            "signature": "vocab:signature",
            "name": "vocab:signatoryName",
            "position": "vocab:position",
            "organisation": "vocab:organisation"
          }
        },

        "transcriptSignatories": {
          "@id": "vocab:transcriptSignatories",
          "@context": {
            "signature": "vocab:signature",
            "position": "vocab:position"
          }
        }
      }
    }
  }
}